# Keeps editors from silently changing the bytes of the source parts.
# (Parts are joined verbatim by Build.ps1 - line endings / BOM / trailing spaces inside
#  here-strings are part of the program.)
root = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
trim_trailing_whitespace = false

[*.txt]
end_of_line = crlf
